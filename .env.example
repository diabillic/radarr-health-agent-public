# Reference for every setting. In production these come from GitHub repo variables/secrets
# and are rendered to /etc/radarr-agent/agent.env on deploy; use this file for local runs.

# --- Required ---
RADARR_URL=http://192.168.1.10:7878
# Radarr > Settings > General > API Key
RADARR_API_KEY=

# Link used in notifications (what you open in a browser)
RADARR_PUBLIC_URL=http://nas.lan:7878

# --- Behaviour ---
# Leave true for the first few days and read the logs/notifications; flip to false to act.
DRY_RUN=true
INTERVAL_MINUTES=10

# Apprise URLs, comma separated: https://github.com/caronc/apprise/wiki
#   discord://webhook_id/webhook_token   pover://user@token   ntfy://ntfy.sh/topic
NOTIFY_URLS=
RENOTIFY_HOURS=12
# Health check sources to ignore (comma separated)
HEALTH_IGNORE=UpdateCheck

# --- Queue thresholds ---
STALL_MINUTES=60
FAILED_PENDING_MINUTES=30
IMPORT_PENDING_MINUTES=30
# This many stalls at once is treated as a SABnzbd problem: escalate, don't blocklist.
MASS_STALL_THRESHOLD=3
# Remove + blocklist downloads whose files are all rejected as "not an upgrade"/sample/etc.
REMOVE_REJECTED=true

# --- Trakt ---
TRAKT_RETRY_HOURS=6

# --- LLM diagnosis via OpenCode Go (optional; disabled when no key) ---
OPENCODE_API_KEY=
# Must be a Chat Completions model on Go: curl https://opencode.ai/inference/go/v1/models
OPENCODE_MODEL=glm-5.2
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
# Let the model remove/blocklist, import, or run safe commands (still honours DRY_RUN).
LLM_ACTIONS=false
ESCALATE_COOLDOWN_HOURS=24
