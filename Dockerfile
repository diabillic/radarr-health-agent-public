# Generated by dockerfile-agent from: deploy/lxc/radarr-agent-install, deploy/lxc/bootstrap-agent.sh, requirements.txt, radarr_agent/config.py, radarr_agent/health.py.
# Don't edit by hand: it's regenerated whenever those files change. Change them instead.
#
# Build: docker build --pull --build-arg PATCHED_AT=$(date +%s) --build-arg REVISION=$(git rev-parse HEAD) -t radarr-agent .
# Run:   docker run -d --name radarr-agent --restart unless-stopped \
#     --env-file agent.env \
#     -v radarr-agent-data:/var/lib/radarr-agent \
#     -p 8765:8765 \
#     radarr-agent
#
# agent.env holds the settings in .env.example (the deploy workflow renders it from repo variables and secrets).

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
ENV TZ=America/New_York

ARG DEBIAN_FRONTEND=noninteractive
ARG PATCHED_AT=unknown
RUN echo "Patching the base OS ($PATCHED_AT)" \
 && apt-get update \
 && apt-get -y full-upgrade \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && ln -snf "/usr/share/zoneinfo/$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN groupadd --system radarr-agent \
 && useradd --system --gid radarr-agent --home-dir /var/lib/radarr-agent --shell /usr/sbin/nologin radarr-agent \
 && install -d -o radarr-agent -g radarr-agent /var/lib/radarr-agent

WORKDIR /opt/radarr-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY radarr_agent/ ./radarr_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/radarr-agent/state.json
USER radarr-agent
VOLUME ["/var/lib/radarr-agent"]
EXPOSE 8765
HEALTHCHECK --interval=60s --timeout=15s --start-period=2m --retries=5 \
  CMD ["python", "-m", "radarr_agent.health"]
CMD ["python", "-m", "radarr_agent"]
